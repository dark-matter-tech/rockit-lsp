// document.rok — Document state management for LSP
// Tracks open documents, their text, and cached analysis results.

// ── Document manager ────────────────────────────────────────────────────

fun docManagerCreate(): Map {
    return mapCreate()
}

fun docOpen(mgr: Map, uri: String, text: String, version: Int): Unit {
    val doc = mapCreate()
    mapPut(doc, "uri", uri)
    mapPut(doc, "version", version)
    mapPut(doc, "text", text)
    mapPut(doc, "lines", docSplitLines(text))
    mapPut(doc, "tokens", null)
    mapPut(doc, "ast", null)
    mapPut(doc, "tc", null)
    mapPut(doc, "diagnostics", jArr())
    mapPut(mgr, uri, doc)
}

fun docUpdate(mgr: Map, uri: String, text: String, version: Int): Unit {
    val doc = mapGet(mgr, uri)
    if (doc == null) {
        docOpen(mgr, uri, text, version)
        return
    }
    mapPut(doc, "text", text)
    mapPut(doc, "version", version)
    mapPut(doc, "lines", docSplitLines(text))
    // Invalidate cached analysis
    mapPut(doc, "tokens", null)
    mapPut(doc, "ast", null)
    mapPut(doc, "tc", null)
    mapPut(doc, "diagnostics", jArr())
}

fun docClose(mgr: Map, uri: String): Unit {
    // Publish empty diagnostics to clear
    rpcPublishDiagnostics(uri, jArr())
    // Note: mapRemove not available, just set to null
    mapPut(mgr, uri, null)
}

fun docGetText(mgr: Map, uri: String): String {
    val doc = mapGet(mgr, uri)
    if (doc == null) { return "" }
    val text = mapGet(doc, "text")
    if (text == null) { return "" }
    return toString(text)
}

fun docGetLines(mgr: Map, uri: String): List {
    val doc = mapGet(mgr, uri)
    if (doc == null) { return listCreate() }
    val lines = mapGet(doc, "lines")
    if (lines == null) { return listCreate() }
    return lines
}

fun docGetAnalysis(mgr: Map, uri: String): Map {
    val doc = mapGet(mgr, uri)
    if (doc == null) { return null }
    val ast = mapGet(doc, "ast")
    if (ast == null) { return null }
    val result = mapCreate()
    mapPut(result, "tokens", mapGet(doc, "tokens"))
    mapPut(result, "ast", ast)
    mapPut(result, "tc", mapGet(doc, "tc"))
    mapPut(result, "diagnostics", mapGet(doc, "diagnostics"))
    return result
}

fun docSetAnalysis(mgr: Map, uri: String, tokens: Any, ast: Any, tc: Any, diagnostics: Any): Unit {
    val doc = mapGet(mgr, uri)
    if (doc == null) { return }
    mapPut(doc, "tokens", tokens)
    mapPut(doc, "ast", ast)
    mapPut(doc, "tc", tc)
    mapPut(doc, "diagnostics", diagnostics)
}

// ── Line splitting ──────────────────────────────────────────────────────

fun docSplitLines(text: String): List {
    val lines = listCreate()
    val len = stringLength(text)
    var start: Int = 0
    var i: Int = 0
    while (i < len) {
        val ch = charCodeAt(text, i)
        if (ch == 10) {
            listAppend(lines, substring(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    // Last line (may not end with newline)
    if (start <= len) {
        listAppend(lines, substring(text, start, len))
    }
    return lines
}

// ── URI helpers ─────────────────────────────────────────────────────────

fun uriToPath(uri: String): String {
    // Strip "file://" prefix
    if (startsWith(uri, "file://") == 1) {
        return substring(uri, 7, stringLength(uri))
    }
    return uri
}

fun pathToUri(path: String): String {
    return "file://" + path
}

// ── Position helpers ────────────────────────────────────────────────────

fun lspToSourceLine(lspLine: Int): Int {
    // LSP lines are 0-indexed, Rockit source is 1-indexed
    return lspLine + 1
}

fun sourceToLspLine(sourceLine: Int): Int {
    return sourceLine - 1
}

fun lspToSourceCol(lspCol: Int): Int {
    return lspCol + 1
}

fun sourceToLspCol(sourceCol: Int): Int {
    return sourceCol - 1
}

fun makeLspPosition(line: Int, character: Int): Map {
    val pos = jsonObject()
    jPutInt(pos, "line", line)
    jPutInt(pos, "character", character)
    return pos
}

fun makeLspRange(startLine: Int, startChar: Int, endLine: Int, endChar: Int): Map {
    val range = jsonObject()
    jPutObj(range, "start", makeLspPosition(startLine, startChar))
    jPutObj(range, "end", makeLspPosition(endLine, endChar))
    return range
}

fun makeLspLocation(uri: String, startLine: Int, startChar: Int, endLine: Int, endChar: Int): Map {
    val loc = jsonObject()
    jPutStr(loc, "uri", uri)
    jPutObj(loc, "range", makeLspRange(startLine, startChar, endLine, endChar))
    return loc
}
