// jsonrpc.rok — JSON-RPC 2.0 protocol layer for LSP
// Uses only standard Rockit builtins (readLine, print, println) for portability.
// Body reading uses stdinReadN/rpcReadBody from linked C helper (lsp_io.o).

// ── JSON convenience wrappers ───────────────────────────────────────────

fun jStr(s: String): Map { return jsonString(s) }
fun jInt(n: Int): Map { return jsonNumber(n) }
fun jBool(b: Bool): Map { return jsonBool(b) }
fun jNull(): Map { return jsonNull() }
fun jPut(obj: Map, key: String, value: Map): Unit { jsonObjectPut(obj, key, value) }
fun jPutStr(obj: Map, key: String, value: String): Unit { jsonObjectPut(obj, key, jsonString(value)) }
fun jPutInt(obj: Map, key: String, value: Int): Unit { jsonObjectPut(obj, key, jsonNumber(value)) }
fun jPutBool(obj: Map, key: String, value: Bool): Unit { jsonObjectPut(obj, key, jsonBool(value)) }
fun jPutNull(obj: Map, key: String): Unit { jsonObjectPut(obj, key, jsonNull()) }
fun jPutObj(obj: Map, key: String, value: Map): Unit { jsonObjectPut(obj, key, value) }
fun jGet(obj: Map, key: String): Map { return jsonObjectGet(obj, key) }
fun jGetStr(obj: Map, key: String): String {
    val v = jsonObjectGet(obj, key)
    if (v == null) { return "" }
    return jsonGetString(v)
}
fun jGetInt(obj: Map, key: String): Int {
    val v = jsonObjectGet(obj, key)
    if (v == null) { return 0 }
    return jsonGetInt(v)
}
fun jArr(): Map { return jsonArray() }
fun jArrPush(arr: Map, item: Map): Unit { jsonArrayAppend(arr, item) }
fun jArrGet(arr: Map, index: Int): Map { return jsonArrayGet(arr, index) }
fun jArrSize(arr: Map): Int { return jsonArraySize(arr) }

// ── Logging ─────────────────────────────────────────────────────────────
// Uses println to stderr via systemExec (ugly but portable)

fun rpcLog(msg: String): Unit {
